<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>it.aegis</groupId>
  <artifactId>aegis</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>AEGIS</name>

  <modules>
    <module>backend/src/config</module>
    <module>backend/src/domain</module>
    <module>backend/src/application</module>
    <module>backend/src/adapters/inmemory</module>
    <module>backend/src/adapters/jpa</module>
    <module>backend/src/adapters/rest</module>
    <module>backend/src/adapters/web</module>
    <module>backend/src/adapters/worker</module>
    <module>backend/src/adapters/routing</module>
    <module>backend/src/adapters/storage</module>
    <module>backend/src/adapters/gtfs</module>
    <module>backend/src/bootstrap</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jakartaee.version>11.0.0</jakartaee.version>
    <faces.version>4.1.21</faces.version>
    <weld.version>6.0.4.Final</weld.version>
    <jersey.version>4.0.3</jersey.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>jakarta.platform</groupId>
        <artifactId>jakarta.jakartaee-bom</artifactId>
        <version>${jakartaee.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>it.aegis</groupId>
        <artifactId>config</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.aegis</groupId>
        <artifactId>domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.aegis</groupId>
        <artifactId>application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.aegis</groupId>
        <artifactId>inmemory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.aegis</groupId>
        <artifactId>jpa</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.aegis</groupId>
        <artifactId>rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.aegis</groupId>
        <artifactId>web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.aegis</groupId>
        <artifactId>worker</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.aegis</groupId>
        <artifactId>routing</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.aegis</groupId>
        <artifactId>storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.aegis</groupId>
        <artifactId>gtfs</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>it.aegis</groupId>
        <artifactId>bootstrap</artifactId>
        <version>${project.version}</version>
        <type>war</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
    </plugins>
  </build>
</project>
